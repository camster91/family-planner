# Database Configuration
DATABASE_URL=postgresql://family_planner:family_planner@postgres:5432/family_planner

# JWT Secret (generate a strong random string for production; min 32 chars)
JWT_SECRET=your-jwt-secret-change-me

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Family Planner"

# Mailgun — transactional email (verification + password reset)
# Non-secret settings live here. The API key does NOT: it belongs in a
# root-owned env file on the VPS, loaded into the container at runtime
# (e.g. /etc/family-planner-mailgun.env, mode 0640). Never commit the key.
MAILGUN_DOMAIN=ashbi.ca
MAILGUN_BASE_URL=https://api.mailgun.net/v3
MAILGUN_FROM="Family Planner <noreply@ashbi.ca>"
# MAILGUN_API_KEY — VPS only, never in this file or any commit.

# Optional: Analytics (for Phase 4)
# POSTHOG_KEY=your_posthog_key
# POSTHOG_HOST=https://app.posthog.com

# Optional: Stripe (for Phase 4)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
