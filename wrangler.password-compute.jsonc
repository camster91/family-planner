{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "herewoven-password-compute",
  "main": "src/cloudflare/password-compute-worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "PASSWORD_COMPUTE", "class_name": "LocalPasswordCompute" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LocalPasswordCompute"] },
  ],
}
