{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "herewoven-migration",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/"
    ]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "herewoven-migration"
    },
    {
      "binding": "PASSWORD_COMPUTE",
      "service": "herewoven-password-compute"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://herewoven.com"
  }
}
