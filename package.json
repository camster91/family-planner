{
  "name": "family-planner-app",
  "version": "0.1.0",
  "private": true,
  "description": "Family planner web app for chore tracking, calendar management, and family communication",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .github/workflows/ci.yml docs/CONSOLIDATION_PLAN.md docs/ISSUE_TRIAGE.md prisma.config.ts \"src/lib/imports/**/*.ts\" \"src/app/api/admin/imports/**/*.ts\" \"src/app/dashboard/settings/imports/**/*.tsx\"",
    "prepare": "husky install",
    "validate": "npm run type-check && npx prisma validate",
    "verify:app": "prisma generate && npm run typecheck && npm run lint && npm test -- --runInBand && npm run build && npm audit --omit=dev --audit-level=high",
    "health": "curl -f http://localhost:3000/api/health || exit 1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "posthog-js": "^1.434.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/eslintrc": "^3.3.7",
    "@hono/node-server": "^2.1.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.25",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "mysql2": "^3.24.4",
    "uuid": "^11.1.1"
  },
  "keywords": [
    "family",
    "planner",
    "chores",
    "calendar",
    "parenting",
    "organization"
  ],
  "author": "Family Planner Team",
  "license": "MIT"
}
