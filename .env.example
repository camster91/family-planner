# Local development template. Copy to .env and fill in values; never commit .env.

# Database (docker-compose.yml requires POSTGRES_PASSWORD; it must match DATABASE_URL)
# Generate a local password with: openssl rand -hex 16
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://family_planner:<POSTGRES_PASSWORD>@postgres:5432/family_planner

# JWT secret: at least 32 characters (enforced in production).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Shared secret for POST /api/cron/recurring-chores (sent as the x-cron-secret
# header). Leave empty to keep the endpoint disabled (it fails closed with 500).
# Scheduling calls to it needs Cameron's explicit approval (AGENTS.md).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where uploaded chore photos are stored (default /data/family-planner-uploads).
# UPLOAD_DIR=./.uploads

# Optional: transactional email (verification, password reset) via Mailgun.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM=
# FROM_EMAIL=

# Optional: AI capture deployment fallback. Families normally set their own
# key in Settings; this key is only ever sent to CAPTURE_AI_BASE_URL.
# CAPTURE_AI_KEY=
# CAPTURE_AI_BASE_URL=https://api.deepseek.com
# CAPTURE_AI_MODEL=deepseek-chat

# Optional: analytics (read at build time by the browser bundle).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# Rate limits use the address the outermost trusted proxy recorded. Default 1.
TRUSTED_PROXY_HOPS=1
