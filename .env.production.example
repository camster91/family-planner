# Production environment template. Configure real values in the hosting
# provider; never commit production secrets or a live .env.production file.
NEXT_PUBLIC_APP_URL=https://family.ashbi.ca
NODE_ENV=production
# PostgreSQL connection string for the production database.
DATABASE_URL=
# At least 32 random characters (openssl rand -hex 32). Rotating it signs out
# every session and invalidates values encrypted with it (src/lib/secret-box.ts).
JWT_SECRET=
# Shared secret for POST /api/cron/recurring-chores. Leave empty to keep the
# endpoint disabled; scheduling it needs Cameron's explicit approval.
CRON_SECRET=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=ashbi.ca
MAILGUN_FROM=Family Planner <noreply@ashbi.ca>

# Optional: maintenance database migrate.js connects through when 'postgres'
# is unavailable (some managed hosts rename it). Leave empty normally.
MIGRATE_FALLBACK_DB=

# Two-way Google / Outlook calendar sync (#264). Leave empty to keep it dormant.
# Setting these in production needs Cameron's approval; see
# docs/runbooks/CALENDAR_SYNC.md. CALENDAR_TOKEN_KEY = openssl rand -base64 32.
APP_URL=
CALENDAR_TOKEN_KEY=
CALENDAR_TOKEN_KEY_PREVIOUS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=

# Shared household tablet mode (#157/#240). Keep off (default). Enabling it in
# production is an environment change that needs Cameron's explicit approval.
SHARED_DEVICE_ENABLED=false

# Fridge photo scan (#265). Leave the key empty (off). Setting it enables a paid
# provider and sends household photos to Anthropic: Cameron's explicit approval
# first. See docs/runbooks/INVENTORY_SCAN.md.
INVENTORY_SCAN_ANTHROPIC_API_KEY=
INVENTORY_SCAN_MODEL=
INVENTORY_SCAN_DAILY_LIMIT=

# Today board weather (#262): server kill switch for Open-Meteo. Off unless set
# to 1 or true (unset means off); each household must still opt in (default
# off). Keep it off until the processor review in
# docs/product/THIRD_PARTY_PROCESSORS.md is done; turning it on in production is
# an environment change for Cameron.
WEATHER_ENABLED=false
# Review-first event import (#270). Leave the key empty (off). Setting it enables
# a paid provider and sends pasted emails, flyer photos and PDFs to Anthropic:
# Cameron's explicit approval first. See docs/runbooks/EVENT_IMPORT.md.
EVENT_IMPORT_ANTHROPIC_API_KEY=
EVENT_IMPORT_MODEL=
EVENT_IMPORT_DAILY_LIMIT=
