# Production environment template. Configure real values in the hosting
# provider; never commit production secrets or a live .env.production file.
NEXT_PUBLIC_APP_URL=https://family.ashbi.ca
NODE_ENV=production
# PostgreSQL connection string for the production database.
DATABASE_URL=
# At least 32 random characters (openssl rand -hex 32). Rotating it signs out
# every session and invalidates values encrypted with it (src/lib/secret-box.ts).
JWT_SECRET=
# Shared secret for POST /api/cron/recurring-chores. Leave empty to keep the
# endpoint disabled; scheduling it needs Cameron's explicit approval.
CRON_SECRET=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=ashbi.ca
MAILGUN_FROM=Family Planner <noreply@ashbi.ca>
